{
  "phoenix_plugin": 1,
  "connector": "calendar",
  "recognize": {
    "mcp_servers": [
      "google-calendar"
    ],
    "hosts": [
      "www.googleapis.com"
    ],
    "commands": []
  },
  "tier": "stateful",
  "operations": [
    "tools/call:list_events",
    "tools/call:get_event",
    "tools/call:move_event"
  ],
  "read_only": [
    "tools/call:list_events",
    "tools/call:get_event"
  ],
  "volatile": [
    "tools/call:sync_changes"
  ],
  "key_rules": [
    {
      "op": "tools/call:list_events",
      "version": "1",
      "remove": [
        "request_id"
      ]
    }
  ],
  "entity_map": {
    "list_events": {
      "kind": "list",
      "entity": "event",
      "items_path": "$.items",
      "id_path": "$.id",
      "complete": "no nextPageToken",
      "filters": [
        {
          "arg": "calendar_id",
          "field": "calendarId",
          "match": "equality"
        },
        {
          "arg": "time_min",
          "field": "start",
          "match": "range"
        }
      ]
    },
    "get_event": {
      "kind": "get",
      "entity": "event",
      "id_path": "$.id"
    },
    "move_event": {
      "kind": "update",
      "entity": "event",
      "id_path": "$.id"
    }
  },
  "capture": {
    "command": [
      "node",
      "capture.js"
    ],
    "protocol": "stdio"
  },
  "serve": {
    "command": [
      "node",
      "serve.js"
    ],
    "protocol": "http",
    "level": "http"
  }
}
