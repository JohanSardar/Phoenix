     }
 }
 
+var phoenix_call_counter = std.atomic.Value(u64).init(0);
+pub threadlocal var phoenix_running_real: bool = false;
+
+/// Phoenix replay: hands one tool call to the stand-in helper and returns its answer instead of running the tool.
+/// Returns null when Phoenix says to run the tool for real, on the copy of the project's files in the box.
+pub fn phoenixStandIn(alloc: Allocator, dir: []const u8, call: message.ToolCall) DispatchError!?AuthorizedDispatchResult {
+    const helper = io_mod.getenv("PHOENIX_FX_TOOL_HELPER") orelse return phoenixStop(alloc);
+    const path = try alloc.print("{s}/call-{d}.json", .{ dir, phoenix_call_counter.fetchAdd(1, .seq_cst) });
+    defer alloc.free(path);
+    const request = try std.json.Stringify.valueAlloc(alloc, .{ .id = call.id, .name = call.name, .arguments_json = call.arguments_json }, .{});
+    defer alloc.free(request);
+    io_mod.writeFileAtomic(alloc, path, request) catch return phoenixStop(alloc);
+    const result = std.process.run(alloc, io_mod.getIo(), .{ .argv = &.{ "node", helper, path } }) catch return phoenixStop(alloc);
+    defer alloc.free(result.stdout);
+    defer alloc.free(result.stderr);
+    if (result.term != .exited or result.term.exited != 0 or result.stdout.len == 0) return phoenixStop(alloc);
+    if (result.stdout[0] == '2') return null;
+    return .{ .status = if (result.stdout[0] == '0') .success else .failure, .body = try alloc.dupe(u8, result.stdout[1..]) };
+}
+
+fn phoenixStop(alloc: Allocator) DispatchError!?AuthorizedDispatchResult {
+    return .{ .status = .failure, .body = try alloc.dupe(u8, "Phoenix stopped this replay: the tool call could not be answered") };
+}
