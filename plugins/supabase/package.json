    "@modelcontextprotocol/server": "2.4.0",
    "@supabase/mcp-server-supabase": "0.17.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "exports": { "./phoenix-plugin.json": "./phoenix-plugin.json" },
  "license": "MIT"
}
